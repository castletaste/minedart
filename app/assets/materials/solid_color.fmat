material {
  name: "SolidColor",
  shading_model: unlit,
  blending: opaque,
  culling: none,
  depth_write: true,
  parameters: [
    { type: vec4, name: color, default: [1.0, 1.0, 1.0, 1.0] },
  ],
}

fragment {
  vec3 SolidSrgbToLinear(vec3 c) {
    vec3 lo = c / 12.92;
    vec3 hi = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(hi, lo, vec3(lessThanEqual(c, vec3(0.04045))));
  }

  void Surface(inout MaterialInputs material) {
    material.base_color =
        vec4(SolidSrgbToLinear(material_params.color.rgb), 1.0);
  }
}
